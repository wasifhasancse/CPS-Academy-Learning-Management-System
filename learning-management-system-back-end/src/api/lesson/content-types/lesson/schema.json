{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "LMS Video Lesson Schema"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "youtubeUrl": {
      "type": "string",
      "required": true
    },
    "duration": {
      "type": "string",
      "default": "10:00"
    },
    "content": {
      "type": "richtext"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isFreePreview": {
      "type": "boolean",
      "default": false
    }
  }
}
