{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "LMS Video & Text Lesson Schema"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "youtubeUrl": {
      "type": "string"
    },
    "duration": {
      "type": "string",
      "default": "10:00"
    },
    "content": {
      "type": "richtext"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isFreePreview": {
      "type": "boolean",
      "default": false
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "lessons"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    }
  }
}
